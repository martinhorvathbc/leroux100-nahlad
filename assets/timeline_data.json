 "captions": [
  {
   "t": 0,
   "fr": "Dans le noir, une première voix. La lumière s’éveille lentement.",
   "sk": "V tme prvý hlas. Svetlo sa pomaly prebúdza.",
   "src": "xlsx r. 7"
  },
  {
   "t": 491,
   "fr": "Le Fantôme n’a pas de corps : sa voix arrive de partout à la fois, et la lumière passe au rouge.",
   "sk": "Fantóm nemá telo: jeho hlas prichádza zo všetkých strán naraz a svetlo prejde do červenej.",
   "src": "xlsx r. 20"
  },
  {
   "t": 940,
   "fr": "Les comédiens jouent en direct, le son les place dans l’espace. Le récit, lui, enveloppe tout le public.",
   "sk": "Herci hrajú naživo, zvuk ich umiestni v priestore. Rozprávanie obklopí celé publikum.",
   "src": "xlsx r. 8, 9, 32; legenda osi LIVE"
  },
  {
   "t": 1935,
   "fr": "Le son et la lumière s’assombrissent ; le rouge du Fantôme gagne la salle.",
   "sk": "Zvuk aj svetlo stmavnú, Fantómova červená zaplní sálu.",
   "src": "xlsx r. 52, 56"
  },
  {
   "t": 2988,
   "fr": "Le rouge du Fantôme, le bleu de Raoul : deux mondes face à face.",
   "sk": "Fantómova červená a Raoulova modrá: dva svety proti sebe.",
   "src": "xlsx r. 110, 118, 133"
  },
  {
   "t": 3495,
   "fr": "Silence. Puis le son tombe d’en haut, de tous côtés, et converge au centre de la salle.",
   "sk": "Ticho. Potom zvuk padne zhora, zo všetkých strán, a zbehne sa v strede sály.",
   "src": "xlsx r. 128"
  },
  {
   "t": 3968,
   "fr": "La salle s’éteint. Le dernier acte garde le rouge, plus sourd.",
   "sk": "Sála zhasne. Posledné dejstvo ostáva v červenej, tlmenejšej.",
   "src": "xlsx r. 154, 156"
  },
  {
   "t": 4313,
   "fr": "La lumière s’éclaircit jusqu’au blanc. La dernière voix emplit toute la salle.",
   "sk": "Svetlo sa rozjasní do bielej. Posledný hlas naplní celú sálu.",
   "src": "xlsx r. 167, 171"
  }
 ]
